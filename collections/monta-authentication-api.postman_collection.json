          "name": "Get an access token with client credentials.",
          "request": {
            "name": "Get an access token with client credentials.",
            "description": {
              "content": "Exchange a clientId and clientSecret for a short-lived bearer access token and a refresh token. The access token must be supplied as a Bearer token on subsequent requests.",
